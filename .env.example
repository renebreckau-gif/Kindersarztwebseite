# Praxis Cockpit backend (Payload + PostgreSQL) — PLACEHOLDERS ONLY.
# Copy to .env (git-ignored) for LOCAL development. Never commit real values.
# The public website does NOT need any of these: it reads static data (DATA_SOURCE = "STATIC").
#
# Local or isolated database only — never a production database from a developer machine.
# Example shape (do not use as-is): postgres://USER:PASSWORD@127.0.0.1:5432/praxis_cockpit_dev
DATABASE_URI=
# Long random value, generated per environment (e.g. `openssl rand -hex 32`).
PAYLOAD_SECRET=
