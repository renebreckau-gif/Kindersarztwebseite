# Praxis Cockpit backend (Payload + PostgreSQL) — PLACEHOLDERS ONLY.
# Copy to .env.local (git-ignored) for LOCAL development. Never commit real values.
# The public website does NOT need any of these: it reads static data (DATA_SOURCE = "STATIC").
# Without DATABASE_URI + PAYLOAD_SECRET, /intern and /api answer 404 (proxy.ts).
#
# Local development: `npm run db:dev -- init` creates an isolated PostgreSQL cluster on
# 127.0.0.1:5433 and writes generated values for the keys below into .env.local.
# Never point these at a production database from a developer machine.
# Shape (do not use as-is): postgresql://USER:PASSWORD@127.0.0.1:5433/kinderarzt_staging_dev
DATABASE_URI=
# Isolated *_test database used by `npm run test:db:clean` (dropped and recreated per run).
TEST_DATABASE_URI=
# Long random value, generated per environment.
PAYLOAD_SECRET=
# Optional: public origin of this deployment (enables Payload's CSRF origin allowlist).
PAYLOAD_SERVER_URL=