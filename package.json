{
  "name": "kinderarztpraxis-probst-boehme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kinderarztpraxis Probst & Böhme — website project (internal prototypes and domain model)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lab:capture": "node scripts/lab-capture.mjs",
    "payload": "payload",
    "db:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-dev.ps1",
    "db:migrate": "payload migrate",
    "db:bootstrap-admin": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.ts",
    "db:seed-dev": "node --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "test:db:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-db-clean.ps1",
    "test": "node --test \"src/domain/__tests__/*.test.ts\" \"src/content/__tests__/*.test.ts\" \"src/data/__tests__/*.test.ts\" \"src/backend/__tests__/*.test.ts\" \"src/cockpit/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@react-three/fiber": "9.8.1",
    "graphql": "16.14.2",
    "next": "16.4.0",
    "payload": "3.90.2",
    "pg": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
